# App configs
PORT=
PASSWORD_SALT=

SECRET=
EXPIRES_IN=

REDIS_KEY_RESERVE_EXPIRESIN=

# Nest Observability configs
APP_KEY=
APP_SECRET=
SERVICEID=

# Postgres Database configs Docker
POSTGRES_USER_DOCKER=       
POSTGRES_PASSWORD_DOCKER= 
POSTGRES_DATABASE_DOCKER=

# Prisma Database Config
DATABASE_URL_DOCKER="postgresql://POSTGRES_USER_DOCKER:POSTGRES_PASSWORD_DOCKER@postgres:5432/POSTGRES_DATABASE_DOCKER?schema=public" # For connect inside of Docker
DATABASE_URL="postgresql://POSTGRES_USER_DOCKER:POSTGRES_PASSWORD_DOCKER@localhost:5432/POSTGRES_DATABASE_DOCKER?schema=public" # For connect outside of Docker 

# Docker Redis 
REDIS_USER_DOCKER=
REDIS_PASSWORD_DOCKER=
REDIS_URL_DOCKER='redis://REDIS_USER_DOCKER:REDIS_PASSWORD_DOCKER@redis:6379'   # For connect inside of Docker 
REDIS_URL='redis://REDIS_USER_DOCKER:REDIS_PASSWORD_DOCKER@localhost:6379' # For connect outside of Docker 

# Docker RabittMQ  
RABBITMQ_USER_DOCKER=
RABBITMQ_USER_PASSWORD=
RABBITMQ_URL_DOCKER="amqp://RABBITMQ_USER_DOCKER:RABBITMQ_USER_PASSWORD@rabbitmq:5672" # For connect inside of Docker
RABBITMQ_URL="amqp://RABBITMQ_USER_DOCKER:RABBITMQ_USER_PASSWORD@localhost:5672" # For connect outside of Docker   
 
