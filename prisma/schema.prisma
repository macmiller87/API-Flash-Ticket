// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/prismaORM/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id        String   @default(uuid())
  name      String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Events {
  id               String        @default(uuid())
  name             String        @unique
  date             DateTime
  place            String
  availableSectors EventsSectors @default(ECONOMIC)
}

enum EventsSectors {
  PREMIUM
  ECONOMIC
}
